<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eland_common</name>
  <version>0.1.0</version>
  <description>Shared class IDs, QoS profiles and PX4 topic names for the emergency landing pipeline.</description>
  <maintainer email="adakarda34@gmail.com">arda</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <!-- eland_perception / eland_mapping are deliberately NOT declared here:
       they depend on this package for qos.py and classes.py, so declaring
       them back would be a dependency cycle. -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
