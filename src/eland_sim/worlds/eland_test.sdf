<?xml version="1.0" encoding="UTF-8"?>
<!--
  Emergency landing test world -- TEMPLATE.

  scripts/gen_world.py renders this into eland_test.sdf, replacing the marker
  near the bottom of this file with the moving person and vehicle described by
  the obstacle_driver parameters in config/eland_params.yaml. Everything
  static lives here; nothing about the dynamic obstacles does, so their
  geometry and their trajectories cannot drift apart.

  The marker token is deliberately not spelled out in this comment: it is
  substituted by plain text replacement, so a second mention would be
  substituted too, and the obstacles would be emitted inside this comment.

  Edit THIS file for static scenery. Editing eland_test.sdf is lost on the
  next generator run, and run_sim.sh runs the generator every time.

  Derived from PX4's Tools/simulation/gz/worlds/default.sdf: same physics,
  same sunUTC light, same spherical_coordinates origin. PX4 supplies the
  simulation plugins through PX4_GZ_SERVER_CONFIG, so no <plugin> entries for
  physics/sensors/user-commands are needed here either.

  WHAT MAKES THIS WORLD DIFFERENT: every model carries a Label system plugin
  assigning it one of the class IDs in eland_common/classes.py. The
  segmentation camera reports label 0 for anything unlabelled, and class 0 is
  UNKNOWN with risk 1.0, so an unlabelled model is not "safe by default" -- it
  is correctly treated as un-landable. That is why ground_plane itself is
  labelled GRASS rather than left bare: without a label the entire world floor
  would read as UNKNOWN and no landing site would ever be found.

  Class IDs (see eland_common/classes.py -- that file is the single source,
  this list is a reader's convenience and must follow it):
    1 GRASS    2 DIRT      3 GRAVEL   4 PAVEMENT  5 VEGETATION
    6 BUILDING 7 WATER     8 VEHICLE  9 PERSON   10 FENCE
   11 POLE    12 SAND

  Layout, in the ENU world frame with the vehicle spawning at the origin:

        +Y (north)
            |   [buildings]
      ======+=================  asphalt road A (y=+18)      ||
            |                                          road B (x=+30)
     [tree] |  o <- vehicle                                 ||
    --------+--------------------------------- +X (east)
     [pond] |  * <- person          [gravel]
      [dirt]|            [tree]
-->
<sdf version="1.9">
  <world name="eland_test">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ============================================================
         Ground: GRASS (1). Carries the world's only collision plane.
         ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.46 0.20 1</ambient>
            <diffuse>0.34 0.55 0.24 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>1</label>
      </plugin>
    </model>

    <!-- ============================================================
         Ground cover patches. All 2 cm slabs resting on the grass, so
         they change the label without changing the terrain the vehicle
         actually touches down on.
         ============================================================ -->

    <!-- PAVEMENT (4) -- road A, running east-west at y = +18 -->
    <model name="road_a">
      <static>true</static>
      <pose>0 18 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>120 8 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>120 8 0.02</size></box></geometry>
          <material>
            <ambient>0.18 0.18 0.19 1</ambient>
            <diffuse>0.24 0.24 0.25 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>4</label>
      </plugin>
    </model>

    <!-- PAVEMENT (4) -- road B, running north-south at x = +30 -->
    <model name="road_b">
      <static>true</static>
      <pose>30 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 120 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 120 0.02</size></box></geometry>
          <material>
            <ambient>0.18 0.18 0.19 1</ambient>
            <diffuse>0.24 0.24 0.25 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>4</label>
      </plugin>
    </model>

    <!-- DIRT (2) -->
    <model name="dirt_patch">
      <static>true</static>
      <pose>-28 -22 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 20 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 20 0.02</size></box></geometry>
          <material>
            <ambient>0.42 0.31 0.19 1</ambient>
            <diffuse>0.52 0.38 0.23 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>2</label>
      </plugin>
    </model>

    <!-- GRAVEL (3) -->
    <model name="gravel_patch">
      <static>true</static>
      <pose>24 -28 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>14 14 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>14 14 0.02</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.43 1</ambient>
            <diffuse>0.58 0.58 0.55 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>3</label>
      </plugin>
    </model>

    <!-- WATER (7) -- a pond. Risk 1.0: never landable, and unlike the
         buildings it is flat, so it is the case that catches a detector
         that reasons about geometry instead of semantics. -->
    <model name="pond">
      <static>true</static>
      <pose>-34 -4 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>18 12 0.02</size></box></geometry>
          <material>
            <ambient>0.10 0.25 0.42 1</ambient>
            <diffuse>0.14 0.34 0.56 1</diffuse>
            <specular>0.7 0.7 0.8 1</specular>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>7</label>
      </plugin>
    </model>

    <!-- ============================================================
         APPROACH TEST SITE -- a paved yard with trees and people on it,
         well away from the main scene at (45, -45).

         Every earlier test spawned the vehicle over open grass, where the
         nearest eligible site is directly beneath it: APPROACH lasted 0.02 s
         and the horizontal travel logic was never actually exercised. Here
         the vehicle starts over asphalt, which is not landable, so it has to
         fly to the grass verge -- about 14 m away.

         Note this uses no hazard class to do the job. Pavement is not a
         hazard, it is simply not in C_safe, so only the 1 m r_fit clearance
         applies to its edge; the people standing on the yard are what the 3 m
         SORA separation acts on. The two mechanisms are doing visibly
         different work in the same scene.

         The shape is deliberate. A site can only be chosen if it is visible,
         and at the 15 m search altitude the footprint is 35.6 m across but
         only 26.7 m tall (the sensor is 4:3), so the usable reach is +-17.8 m
         east-west against +-13.4 m north-south. Hence a yard that is narrow
         east-west and long north-south: it forces the escape sideways, into
         the direction that has room to see.
         ============================================================ -->
    <model name="yard_pavement">
      <static>true</static>
      <pose>45 -45 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>26 60 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>26 60 0.02</size></box></geometry>
          <material>
            <ambient>0.18 0.18 0.19 1</ambient>
            <diffuse>0.24 0.24 0.25 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>4</label>
      </plugin>
    </model>

    <!-- VEGETATION (5) on the yard. Not landable, not a hazard: they shrink
         the search space without invoking a separation radius. -->
    <model name="yard_tree_1">
      <static>true</static>
      <pose>39 -52 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 4 0 0 0</pose>
          <geometry><cylinder><radius>2.3</radius><length>8</length></cylinder></geometry>
        </collision>
        <visual name="trunk">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.34</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.25 0.16 0.09 1</ambient><diffuse>0.34 0.22 0.12 1</diffuse></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 4.6 0 0 0</pose>
          <geometry><sphere><radius>2.3</radius></sphere></geometry>
          <material><ambient>0.12 0.30 0.10 1</ambient><diffuse>0.17 0.40 0.14 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>5</label>
      </plugin>
    </model>

    <model name="yard_tree_2">
      <static>true</static>
      <pose>51 -38 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 3.5 0 0 0</pose>
          <geometry><cylinder><radius>2.0</radius><length>7</length></cylinder></geometry>
        </collision>
        <visual name="trunk">
          <pose>0 0 1.3 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>2.6</length></cylinder></geometry>
          <material><ambient>0.25 0.16 0.09 1</ambient><diffuse>0.34 0.22 0.12 1</diffuse></material>
        </visual>
        <visual name="canopy">
          <pose>0 0 4.0 0 0 0</pose>
          <geometry><sphere><radius>2.0</radius></sphere></geometry>
          <material><ambient>0.12 0.30 0.10 1</ambient><diffuse>0.17 0.40 0.14 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>5</label>
      </plugin>
    </model>

    <!-- PERSON (9) on the yard. These are the reason the vehicle cannot
         simply drop onto the first patch of grass it reaches on the east
         side: yard_person_2 stands 4 m from the eastern verge, so its 3 m
         SORA radius eats into it. -->
    <model name="yard_person_1">
      <static>true</static>
      <pose>42 -43 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.8</length></cylinder></geometry>
          <material><ambient>0.70 0.45 0.10 1</ambient><diffuse>0.90 0.58 0.13 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>9</label>
      </plugin>
    </model>

    <model name="yard_person_2">
      <static>true</static>
      <pose>54 -47 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.8</length></cylinder></geometry>
          <material><ambient>0.70 0.45 0.10 1</ambient><diffuse>0.90 0.58 0.13 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>9</label>
      </plugin>
    </model>

    <!-- ============================================================
         BUILDING (6) -- the obstacle cluster north of road A.
         ============================================================ -->
    <model name="building_1">
      <static>true</static>
      <pose>-22 32 4.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 10 9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 10 9</size></box></geometry>
          <material>
            <ambient>0.55 0.52 0.48 1</ambient>
            <diffuse>0.68 0.65 0.60 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>6</label>
      </plugin>
    </model>

    <model name="building_2">
      <static>true</static>
      <pose>-4 34 3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 8 6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 8 6</size></box></geometry>
          <material>
            <ambient>0.50 0.45 0.42 1</ambient>
            <diffuse>0.62 0.57 0.53 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>6</label>
      </plugin>
    </model>

    <model name="building_3">
      <static>true</static>
      <pose>14 33 6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 10 12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 10 12</size></box></geometry>
          <material>
            <ambient>0.58 0.55 0.50 1</ambient>
            <diffuse>0.72 0.68 0.62 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>6</label>
      </plugin>
    </model>

    <!-- ============================================================
         VEGETATION (5) -- trees. Trunk and canopy share one model, so
         they share one label: semantic segmentation does not separate
         them, and the landing policy has no reason to either.
         ============================================================ -->
    <model name="tree_1">
      <static>true</static>
      <pose>-12 5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 4 0 0 0</pose>
          <geometry><cylinder><radius>2.4</radius><length>8</length></cylinder></geometry>
        </collision>
        <visual name="trunk">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>3</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.16 0.09 1</ambient>
            <diffuse>0.34 0.22 0.12 1</diffuse>
          </material>
        </visual>
        <visual name="canopy">
          <pose>0 0 4.6 0 0 0</pose>
          <geometry><sphere><radius>2.4</radius></sphere></geometry>
          <material>
            <ambient>0.12 0.30 0.10 1</ambient>
            <diffuse>0.17 0.40 0.14 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>5</label>
      </plugin>
    </model>

    <model name="tree_2">
      <static>true</static>
      <pose>-17 -9 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 3.5 0 0 0</pose>
          <geometry><cylinder><radius>2.1</radius><length>7</length></cylinder></geometry>
        </collision>
        <visual name="trunk">
          <pose>0 0 1.3 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>2.6</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.16 0.09 1</ambient>
            <diffuse>0.34 0.22 0.12 1</diffuse>
          </material>
        </visual>
        <visual name="canopy">
          <pose>0 0 4.0 0 0 0</pose>
          <geometry><sphere><radius>2.1</radius></sphere></geometry>
          <material>
            <ambient>0.12 0.30 0.10 1</ambient>
            <diffuse>0.17 0.40 0.14 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>5</label>
      </plugin>
    </model>

    <model name="tree_3">
      <static>true</static>
      <pose>9 -13 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 4 0 0 0</pose>
          <geometry><cylinder><radius>2.6</radius><length>8</length></cylinder></geometry>
        </collision>
        <visual name="trunk">
          <pose>0 0 1.6 0 0 0</pose>
          <geometry><cylinder><radius>0.38</radius><length>3.2</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.16 0.09 1</ambient>
            <diffuse>0.34 0.22 0.12 1</diffuse>
          </material>
        </visual>
        <visual name="canopy">
          <pose>0 0 4.9 0 0 0</pose>
          <geometry><sphere><radius>2.6</radius></sphere></geometry>
          <material>
            <ambient>0.12 0.30 0.10 1</ambient>
            <diffuse>0.17 0.40 0.14 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>5</label>
      </plugin>
    </model>

    <model name="tree_4">
      <static>true</static>
      <pose>19 9 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 3.5 0 0 0</pose>
          <geometry><cylinder><radius>2.2</radius><length>7</length></cylinder></geometry>
        </collision>
        <visual name="trunk">
          <pose>0 0 1.4 0 0 0</pose>
          <geometry><cylinder><radius>0.32</radius><length>2.8</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.16 0.09 1</ambient>
            <diffuse>0.34 0.22 0.12 1</diffuse>
          </material>
        </visual>
        <visual name="canopy">
          <pose>0 0 4.2 0 0 0</pose>
          <geometry><sphere><radius>2.2</radius></sphere></geometry>
          <material>
            <ambient>0.12 0.30 0.10 1</ambient>
            <diffuse>0.17 0.40 0.14 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>5</label>
      </plugin>
    </model>

    <model name="tree_5">
      <static>true</static>
      <pose>-31 13 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 4 0 0 0</pose>
          <geometry><cylinder><radius>2.5</radius><length>8</length></cylinder></geometry>
        </collision>
        <visual name="trunk">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.36</radius><length>3</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.16 0.09 1</ambient>
            <diffuse>0.34 0.22 0.12 1</diffuse>
          </material>
        </visual>
        <visual name="canopy">
          <pose>0 0 4.7 0 0 0</pose>
          <geometry><sphere><radius>2.5</radius></sphere></geometry>
          <material>
            <ambient>0.12 0.30 0.10 1</ambient>
            <diffuse>0.17 0.40 0.14 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>5</label>
      </plugin>
    </model>

    <!-- ============================================================
         VEHICLE (8) and PERSON (9).

         These two are what make the SORA rule testable. Everything else
         in this world is rejected for being the wrong surface; these are
         rejected because something that can be hurt is standing there.
         The person sits on open grass 8 m from the spawn point, i.e.
         exactly where a naive "nearest large flat area" detector would
         otherwise want to land.
         ============================================================ -->
    <model name="parked_vehicle">
      <static>true</static>
      <pose>6 18 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.4 1.9 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.4 1.9 1.5</size></box></geometry>
          <material>
            <ambient>0.45 0.10 0.10 1</ambient>
            <diffuse>0.62 0.14 0.14 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>8</label>
      </plugin>
    </model>

    <model name="person">
      <static>true</static>
      <pose>-6 -6 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>1.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.8</length></cylinder></geometry>
          <material>
            <ambient>0.70 0.45 0.10 1</ambient>
            <diffuse>0.90 0.58 0.13 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>9</label>
      </plugin>
    </model>

    <!-- ============================================================
         Added 2026-09-04: more classes and more to avoid.

         FENCE(10) and POLE(11) are new classes, and they are the interesting
         ones: both are thin. A fence is 12 cm across and a pole 32 cm, which
         at the map's 0.2 m resolution is one or two cells. They test whether
         a hazard has to be big to be respected -- the distance transform does
         not care how large the obstacle is, only how far away it is.

         SAND(12) is new and landable, softer than gravel. It gives the risk
         ordering something to do beyond separating safe from unsafe.

         Placement keeps the middle of the map open on purpose. The point is
         to make the choice harder, not to make landing impossible.
         ============================================================ -->

    <model name="fence_south_a">
      <static>true</static>
      <pose>-16.0 -15.0 0.9 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.0 0.12 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
