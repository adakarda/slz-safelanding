<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eland_sim</name>
  <version>0.1.0</version>
  <description>Gazebo models, worlds, launch files and parameters for the emergency landing simulation.</description>
  <maintainer email="adakarda34@gmail.com">arda</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <!-- eland_perception / eland_mapping are launched by name at runtime and
       are not declared here, to keep this package free of build-order
       coupling to the nodes it starts. -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
