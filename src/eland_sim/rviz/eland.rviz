Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: map
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: GroundMap
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /eland/ground_map
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
Window Geometry:
  Height: 800
  Width: 1200
