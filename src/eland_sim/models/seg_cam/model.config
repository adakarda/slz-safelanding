<?xml version="1.0"?>
<model>
  <name>seg_cam</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Downward-looking ground-truth semantic segmentation camera.

    Derived from PX4's mono_cam model, with the type="camera" sensor swapped
    for type="segmentation". Deliberately low resolution and update rate: this
    machine renders with llvmpipe (no GPU), and the segmentation camera is
    ogre2-only, so there is no cheaper render path to fall back to.
  </description>
</model>
