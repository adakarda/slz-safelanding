<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eland_rl</name>
  <version>0.1.0</version>
  <description>Light training environment and policy for the RL emergency landing study (Bartolomei et al., IROS 2022 method).</description>
  <maintainer email="adakarda34@gmail.com">arda</maintainer>
  <license>MIT</license>

  <exec_depend>eland_common</exec_depend>
  <!-- gymnasium, stable-baselines3 and torch are not rosdep keys: they live in
       ~/rl_inis/venv (system site packages on). See docs/onkayit/rl_f0_onkayit.md. -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
